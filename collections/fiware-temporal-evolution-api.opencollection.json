          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/temporal/entities/:entityId/attrs/:attrId/:instanceId",
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path",
                "description": "Entity Id"
              },
              {
                "name": "attrId",
                "value": "",
                "type": "path",
                "description": "Attribute Id"
              },
              {
                "name": "instanceId",
                "value": "",
                "type": "path",
                "description": "Instance Id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Allows modifying a specific Attribute (Property or Relationship) instance, identified by its instanceId, of a Temporal Representation of an Entity."
        },
        {
          "info": {
            "name": "removeEntityTemporalAttrInstance",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/temporal/entities/:entityId/attrs/:attrId/:instanceId",
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path",
                "description": "Entity Id"
              },
              {
                "name": "attrId",
                "value": "",
                "type": "path",
                "description": "Attribute Id"
              },
              {
                "name": "instanceId",
                "value": "",
                "type": "path",
                "description": "Instance Id"
              }
            ]
          },
          "docs": "Attribute Instance deletion by instance id."
